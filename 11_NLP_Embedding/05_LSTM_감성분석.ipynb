    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "# 어휘사전 어휘수: 10개\n",
    "# 임베딩 벡터 차원수: 3차원 \n",
    "e_layer = nn.Embedding(\n",
    "    num_embeddings=10,\n",
    "    embedding_dim=3,\n",
    ")\n",
    "# 10 x 3 weight 행렬을 생성 -> weight행렬이 전체 어휘들의 embedding vector들"
   ]
